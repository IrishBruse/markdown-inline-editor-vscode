{
  "extensions.ignoreRecommendations": true,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "window.autoDetectColorScheme": false,
  "window.zoomLevel": 0,
  "workbench.sideBar.visible": false,
  "workbench.activityBar.visible": false,
  "workbench.statusBar.visible": false,
  "editor.fontFamily": "monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 20,
  "editor.lineNumbers": "on",
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.minimap.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.renderLineHighlight": "none",
  "editor.overviewRulerBorder": false,
  "markdownInlineEditor.tables.renderingMode": "custom",
  "markdownInlineEditor.colors.tableBackground": "#111111",
  "markdownInlineEditor.colors.tableHeaderBackground": "#222222",
  "markdownInlineEditor.colors.tableBorder": "#666666",
  "markdownInlineEditor.colors.tableText": "#eeeeee"
}
