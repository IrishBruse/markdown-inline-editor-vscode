{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^\\[watch\\] (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\]",
          "endsPattern": "^\\[watch\\] build finished, watching for changes\\.\\.\\.$"
        }
      }
    },
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "compile:e2e",
      "type": "npm",
      "script": "compile:e2e",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    }
  ]
}
